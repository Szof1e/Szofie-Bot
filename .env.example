# Copy to .env. Never commit the real .env file.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: comma-separated guild IDs for instant development command sync.
# Leave blank to register global commands.
GUILD_ID=

# Optional: comma-separated IDs authorised to run normal owner administration.
# This grants permissions only, not gameplay advantages.
OWNER_IDS=

# Optional: channel ID for explicitly reviewed and approved patch notes.
# Leave blank to disable delivery.
PATCHNOTES_CHANNEL_ID=

LOG_LEVEL=INFO

# Optional shared economy: first guild is canonical, following guilds alias it.
# Leave blank for independent server economies.
ECON_SHARED_GUILDS=
